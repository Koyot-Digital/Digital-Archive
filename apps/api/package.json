{
  "name": "@archive/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:text": "tsx watch src/entry/text.ts",
    "dev:images": "tsx watch src/entry/images.ts",
    "dev": "concurrently -n text,images -c cyan,magenta \"pnpm dev:text\" \"pnpm dev:images\"",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start:text": "node dist/entry/text.js",
    "start:images": "node dist/entry/images.js",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/scripts/seed.ts",
    "apikey": "tsx src/scripts/create-api-key.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@archive/shared": "workspace:*",
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/under-pressure": "^9.0.1",
    "drizzle-orm": "^0.36.4",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.1",
    "file-type": "^19.6.0",
    "ioredis": "^5.4.1",
    "markdown-it": "^14.1.0",
    "pino": "^9.5.0",
    "postgres": "^3.4.5",
    "sanitize-html": "^2.13.1",
    "sharp": "^0.33.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.9.0",
    "@types/sanitize-html": "^2.13.0",
    "concurrently": "^9.1.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
