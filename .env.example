# ─────────────────────────────────────────────────────────────────────────────
#  Digital Archive - environment
#  Copy to .env and fill in. NEVER commit .env.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=info

# ── Public hostnames ────────────────────────────────────────────────────────
# ROOT_DOMAIN scopes the session and OAuth-state cookies, so WEB_ORIGIN and
# API_ORIGIN must BOTH be hosts under it. A browser drops a Set-Cookie whose
# Domain is not a suffix of the responding host, so pointing API_ORIGIN at an
# unrelated domain does not degrade - sign-in fails outright with
# "OAuth state mismatch", because the state cookie was never stored.
#
# A second domain can still serve machine traffic (ingress, uploads): those
# authenticate with an API key and never touch a cookie. It just cannot be the
# host the browser is sent to for auth.
ROOT_DOMAIN=chrisrelf.cc
WEB_ORIGIN=https://archive.chrisrelf.cc
API_ORIGIN=https://api.chrisrelf.cc
# Mount prefix for every API route. Keep in sync with the Caddyfile.
API_PREFIX=/digitalarchive/v1

# ── Ports (bound to 127.0.0.1 by the compose file; tunnels reach them) ──────
TEXT_PORT=4001
IMAGES_PORT=4002
# Honoured in local development too (apps/web/scripts/dev.mjs). Change it if
# something else on the machine already owns 3000 - `next dev` would otherwise
# wander to the next free port and the site would come up somewhere unexpected.
WEB_PORT=3000
# Bind address for `pnpm dev`. Pinned to one network stack on purpose: with
# localhost resolving to ::1 before 127.0.0.1, an unpinned dev server can
# appear to start on a port another process already holds.
WEB_HOST=127.0.0.1

# ── Postgres ───────────────────────────────────────────────────────────────
POSTGRES_USER=archive
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=archive
DATABASE_URL=postgres://archive:change-me-postgres@postgres:5432/archive
# Local (non-docker) development:
# DATABASE_URL=postgres://archive:change-me-postgres@127.0.0.1:5432/archive
PG_POOL_MAX=16

# ── Redis (rate limits, ingress idempotency, hot caches) ───────────────────
REDIS_URL=redis://redis:6379
# REDIS_URL=redis://127.0.0.1:6379

# ── Secrets - generate with: openssl rand -hex 32 ──────────────────────────
SESSION_SECRET=change-me-64-hex-chars-session
# Optional. When set, /ingress also requires X-Archive-Signature over the raw body.
INGRESS_HMAC_SECRET=change-me-64-hex-chars-hmac
# Shared secret for text -> images calls inside the docker network. Required.
INTERNAL_TOKEN=change-me-64-hex-chars-internal

# ── Auth ───────────────────────────────────────────────────────────────────
# The archive is private. Nothing - no record, no image, no search, no API
# read - is served without a Discord session whose account holds one of the
# roles listed below in DISCORD_REQUIRED_GUILD_ID.
#
# false => every request is a synthetic dev admin. NEVER false in production;
# the API refuses to boot with this combination under NODE_ENV=production.
AUTH_ENABLED=false
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must be on API_ORIGIN, and registered verbatim in the Discord portal.
DISCORD_REDIRECT_URI=https://api.chrisrelf.cc/digitalarchive/v1/auth/discord/callback

# The guild whose roles decide access. Required when AUTH_ENABLED=true:
# every app role is derived from a role here, so there is nothing to derive
# from without it.
DISCORD_REQUIRED_GUILD_ID=

# ── Who gets in ────────────────────────────────────────────────────────────
# Comma-separated *role* snowflakes from the guild above (right-click a role
# in Discord with developer mode on -> Copy Role ID). Highest wins.
#
# This is the access control list, and it is exhaustive: an account in the
# guild holding none of these roles gets no session, no user row and no data.
# Boot fails if all five of these lists are empty, rather than quietly serving
# a site nobody can enter.
#
# Changing a role in Discord takes effect within ROLE_RECHECK_MINUTES - no
# restart, no re-deploy, and no waiting for a cookie to expire.
ADMIN_DISCORD_ROLE_IDS=
MODERATOR_DISCORD_ROLE_IDS=
VIEWER_DISCORD_ROLE_IDS=

# Per-account overrides, by Discord *user* snowflake. Kept so an owner can
# reach the admin tools without depending on a guild role staying intact, but
# they are overrides rather than the primary mechanism: neither one can let in
# an account that has left the guild.
ADMIN_DISCORD_IDS=
MODERATOR_DISCORD_IDS=

SESSION_TTL_DAYS=14
# How long a session is trusted before its owner's guild roles are re-fetched
# from Discord. This is the real revocation window: a role removed in Discord
# ends the session within this many minutes, which is why a 14-day cookie is
# not a 14-day grant. Costs one Discord API call per signed-in account per
# interval, de-duplicated through Redis.
ROLE_RECHECK_MINUTES=15

# ── Discord identity resolution (optional) ─────────────────────────────────
# Bot token used to look up the Discord accounts that appear on scraped
# records - the moderator who filed a log and whoever argued about it.
#
# Separate from the OAuth credentials above, and genuinely optional: a scrape
# already carries the usernames and avatars it saw, so without a token the
# archive renders those and labels them "as scraped" instead of refreshing
# them. The identify OAuth scope cannot substitute - it only ever describes
# the signed-in user, never a third party.
#
# Needs no privileged intents; GET /users/{id} works with a bare bot token.
# Create one at discord.com/developers/applications.
#
# REQUIRED when AUTH_ENABLED=true, for a second job the comment above does not
# cover: re-checking a signed-in account's guild roles while nobody is standing
# in front of an OAuth prompt. The `guilds.members.read` scope only ever
# answers for the account currently signing in, so without a bot token a role
# removed in Discord would keep working until the cookie expired. The bot must
# be a member of DISCORD_REQUIRED_GUILD_ID for this lookup to work.
DISCORD_BOT_TOKEN=
# How long a resolved identity is trusted before it is fetched again (hours).
DISCORD_USER_TTL_HOURS=168

# ── Image pipeline ─────────────────────────────────────────────────────────
STORAGE_ROOT=/data/storage
IMAGE_MAX_UPLOAD_BYTES=26214400
IMAGE_MAX_EDGE=2400
IMAGE_WEBP_QUALITY=72
IMAGE_THUMB_EDGE=480
IMAGE_THUMB_QUALITY=58
IMAGE_MAX_PER_LOG=24

# ── Rate limits ────────────────────────────────────────────────────────────
RATE_LIMIT_PUBLIC_PER_MIN=240
RATE_LIMIT_INGRESS_PER_MIN=120
RATE_LIMIT_UPLOAD_PER_MIN=60

# ── Link embeds ────────────────────────────────────────────────────────────
# Server-side OpenGraph unfurling for links found in modlog bodies.
EMBED_UNFURL_ENABLED=true
EMBED_UNFURL_TIMEOUT_MS=4000

# ── Web app (build + runtime) ──────────────────────────────────────────────
# Browser-visible API base (through the tunnel). Baked in at build time, so
# changing it needs `docker compose build web`, not just a restart.
NEXT_PUBLIC_API_BASE=https://api.chrisrelf.cc/digitalarchive/v1
# Server-side API base used by RSC fetches (stays on the docker network).
INTERNAL_TEXT_API=http://api-text:4001/digitalarchive/v1
INTERNAL_IMAGES_API=http://api-images:4002/digitalarchive/v1
NEXT_PUBLIC_SITE_NAME=Digital Archive

# ── Cloudflare tunnels ─────────────────────────────────────────────────────
# One tunnel per zone. The images/text split is a path rule inside the api
# tunnel, not a third tunnel - see infra/cloudflared/README.md.
TUNNEL_TOKEN_WEB=
TUNNEL_TOKEN_API=
